vertexlitgeneric

{
$baseTexture "models\infected\screamer_l4d1\screamer_l4d1_face"
$bumpmap "models\infected\screamer_l4d1\screamer_l4d1_face_normal"


$emissiveBlendEnabled 		"1"
	
		$emissiveBlendFlowTexture		"vgui/white"
		$emissiveBlendTexture		"vgui/white"
		$emissiveBlendBaseTexture		"models\infected\screamer_l4d1/l4d1_glow"
	
		$emissiveBlendTint 			"[1 1 1]"
		$emissiveBlendStrength 		"0.35"
		$emissiveBlendScrollVector 		"[0.0 0.0]" 





$phong 1
$phongfresnelranges "[.01 .25 3]"
$phongtint "[.8 .8 1]"
$phongboost 14
$phongexponent 16

$detail "effects/burned.vtf"
$seamless_detail 1
$seamless_scale ".005"
$detailscale 4
$detailblendfactor .001
$detailblendmode 2
$bbqamount 1
$BurnLevel 0.0
$multi 8.0
$blendMin 0.0
$blendMax 1.0
Proxies
{
BBQLevel
{
resultVar $bbqamount
}
BurnLevel
{
resultVar $burnlevel
}
Multiply
{
srcVar1 $BurnLevel
srcVar2 $multi
resultVar $BurnLevel
}
Clamp
{
min $blendMin
max $blendMax
srcVar1 $BurnLevel
resultVar $BurnLevel
}
Equals
{
srcVar1 $BurnLevel
resultVar $detailblendfactor
}
}
}